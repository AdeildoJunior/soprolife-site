# Núcleo Operacional Nativo SoproLife — M15
# Copie para .env e ajuste. NUNCA commitar o .env real (só este .example entra no Git).

# Banco de dados.
# PostgreSQL 16 (produção/local com Podman/Docker Compose):
#   M15_DATABASE_URL=postgresql+psycopg://soprolife:TROCAR_SENHA@127.0.0.1:5432/soprolife_m15
# SQLite (desenvolvimento rápido / testes sem PostgreSQL):
#   M15_DATABASE_URL=sqlite:///./var/m15_nucleo.db
M15_DATABASE_URL=sqlite:///./var/m15_nucleo.db

# Ambiente: dev | prod (Literal validado — qualquer outro valor falha).
# Em prod (fail-closed):
#   - M15_AUTH_SECRET é obrigatório, >=32 caracteres e >=10 símbolos distintos;
#   - bind fora de loopback é sempre rejeitado.
M15_ENV=dev

# Segredo para assinatura de tokens (obrigatório em prod).
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
# M15_AUTH_SECRET=

# Validade do token em minutos (faixa aceita: 5 a 720; padrão 120).
M15_TOKEN_TTL_MINUTES=120

# Sessão de navegador M21. O cookie é HttpOnly + SameSite=Strict e, em prod,
# Secure é forçado mesmo que a variável abaixo tente desligá-lo.
M15_SESSION_COOKIE_NAME=soprolife_m15_sessao
M15_SESSION_COOKIE_PATH=/painel-soprolife
M15_SESSION_COOKIE_SECURE=false
# Sem "manter conectado": expiração server-side explícita (5..720 min).
M15_SESSION_TTL_MINUTES=720
# Com "manter conectado": máximo absoluto validado de 7 dias.
M15_SESSION_PERSISTENT_DAYS=7

# Fila mínima do botão "Atualizar dados" de Marketing. Em produção a unit
# define o caminho privado compartilhado com o timer.
M15_MARKETING_REFRESH_QUEUE=./var/marketing-refresh-request.json

# Bind da API — o entrypoint oficial (python -m app.serve) usa e IMPÕE
# estes valores. Manter em loopback; NÃO expor publicamente.
M15_API_HOST=127.0.0.1
M15_API_PORT=8015

# Origens permitidas (painel local). Sempre explícitas — '*' é rejeitado.
M15_CORS_ORIGINS=["http://127.0.0.1:8765","http://localhost:8765"]

# Fuso de apresentação (armazenamento é sempre UTC).
M15_DISPLAY_TIMEZONE=America/Sao_Paulo

# Senha usada pelo docker-compose.yml para o PostgreSQL local (sem default).
# POSTGRES_PASSWORD=

# Diretório privado APROVADO para snapshots de migração (M15.6A): manifestos,
# CSVs de snapshot e evidências de backup. Sempre fora do Git; nomes de
# arquivo simples (sem caminho) — path traversal é rejeitado fail-closed.
# M15_IMPORT_PRIVATE_DIR=data-private/import-snapshots

# Feature independente de laudos: permanece desabilitada até aprovação dos
# bloqueios clínicos/produto. Ativar o restante do M15 não altera este valor.
M15_REPORTS_ENABLED=false
# Override estritamente para testes M24C isolados em dev. O default é false
# e `true` é recusado quando M15_ENV=prod. Nunca persistir em produção.
M15_REPORTS_TEST_ALLOW_PROVISIONAL_TEMPLATES=false
# As autorizações SOPROLIFE_REPORTS_GO_LIVE e
# SOPROLIFE_REPORTS_BACKUP_COORDINATED pertencem exclusivamente ao processo
# futuro de deploy e NÃO devem ser persistidas neste EnvironmentFile.

# Raiz privada dos PDFs de laudos (M24A). Obrigatória para um futuro uso do fluxo de
# laudos; deve ser absoluta, não ser symlink e ficar fora do repositório Git.
# Em produção, crie antes como soprolife:soprolife 0700 e libere exatamente
# este caminho no ReadWritePaths da unit systemd. Diretórios internos são
# verificados/criados 0700 e arquivos nascem 0600, sem depender do umask.
# M15_REPORTS_STORAGE_DIR=/opt/soprolife/private/m15-reports

# Testes com PostgreSQL real (pytest pula os testes PG sem esta variável):
# M15_TEST_POSTGRES_URL=postgresql+psycopg://postgres:senha@127.0.0.1:55432/m15_teste

# ------------------------------------- M26.4 — portal de resultados do paciente
#
# Superfície PÚBLICA mínima, desligada por padrão. Um deploy de código nunca
# abre o portal por efeito colateral.
#
# ATENÇÃO ao que fica em CADA arquivo em produção:
#   /opt/soprolife/secrets/m15.env        (serviço interno)
#     M15_PORTAL_TOKEN_KEY      SIM  — deriva o link do paciente
#     M15_PORTAL_SESSION_SECRET não
#   /opt/soprolife/secrets/m26-4-portal.env  (serviço público)
#     M15_PORTAL_TOKEN_KEY      NÃO  — o portal não emite link nenhum
#     M15_PORTAL_SESSION_SECRET SIM  — assina o cookie do paciente
#
# O processo público também recebe um M15_AUTH_SECRET próprio e descartável:
# ele existe só porque a validação de produção o exige em qualquer processo,
# e não é — nunca — o segredo do Command Center.
M15_PORTAL_ENABLED=false
# Endereço amigável que o paciente reconhece. HTTPS obrigatório.
# M15_PORTAL_PUBLIC_BASE_URL=https://soprolife.com.br/resultados
# Bind do processo público: SEMPRE loopback. Quem termina em HTTPS é o
# nginx do subdomínio técnico.
M15_PORTAL_API_HOST=127.0.0.1
M15_PORTAL_API_PORT=8016
# Gere cada um com: python3 -c "import secrets; print(secrets.token_hex(32))"
# M15_PORTAL_TOKEN_KEY=
# M15_PORTAL_SESSION_SECRET=
M15_PORTAL_COOKIE_NAME=soprolife_resultado
M15_PORTAL_CORS_ORIGINS=["https://soprolife.com.br"]
# Sessão curta do paciente (5..120 minutos).
M15_PORTAL_SESSION_TTL_MINUTES=30
# Validade do link externo (7..365 dias). Regenerável pelo administrador.
M15_PORTAL_ACCESS_TTL_DAYS=90
