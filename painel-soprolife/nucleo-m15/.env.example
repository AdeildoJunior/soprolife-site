# Núcleo Operacional Nativo SoproLife — M15
# Copie para .env e ajuste. NUNCA commitar o .env real (só este .example entra no Git).

# Banco de dados.
# PostgreSQL 16 (produção/local com Podman/Docker Compose):
#   M15_DATABASE_URL=postgresql+psycopg://soprolife:TROCAR_SENHA@127.0.0.1:5432/soprolife_m15
# SQLite (desenvolvimento rápido / testes sem PostgreSQL):
#   M15_DATABASE_URL=sqlite:///./var/m15_nucleo.db
M15_DATABASE_URL=sqlite:///./var/m15_nucleo.db

# Ambiente: dev | prod (Literal validado — qualquer outro valor falha).
# Em prod (fail-closed):
#   - M15_AUTH_SECRET é obrigatório, >=32 caracteres e >=10 símbolos distintos;
#   - bind fora de loopback é sempre rejeitado.
M15_ENV=dev

# Segredo para assinatura de tokens (obrigatório em prod).
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
# M15_AUTH_SECRET=

# Validade do token em minutos (faixa aceita: 5 a 720; padrão 120).
M15_TOKEN_TTL_MINUTES=120

# Sessão de navegador M21. O cookie é HttpOnly + SameSite=Strict e, em prod,
# Secure é forçado mesmo que a variável abaixo tente desligá-lo.
M15_SESSION_COOKIE_NAME=soprolife_m15_sessao
M15_SESSION_COOKIE_PATH=/painel-soprolife/api/m15
M15_SESSION_COOKIE_SECURE=false
# Sem "manter conectado": expiração server-side explícita (5..720 min).
M15_SESSION_TTL_MINUTES=720
# Com "manter conectado": máximo absoluto validado de 7 dias.
M15_SESSION_PERSISTENT_DAYS=7

# Fila mínima do botão "Atualizar dados" de Marketing. Em produção a unit
# define o caminho privado compartilhado com o timer.
M15_MARKETING_REFRESH_QUEUE=./var/marketing-refresh-request.json

# Bind da API — o entrypoint oficial (python -m app.serve) usa e IMPÕE
# estes valores. Manter em loopback; NÃO expor publicamente.
M15_API_HOST=127.0.0.1
M15_API_PORT=8015

# Origens permitidas (painel local). Sempre explícitas — '*' é rejeitado.
M15_CORS_ORIGINS=["http://127.0.0.1:8765","http://localhost:8765"]

# Fuso de apresentação (armazenamento é sempre UTC).
M15_DISPLAY_TIMEZONE=America/Sao_Paulo

# Senha usada pelo docker-compose.yml para o PostgreSQL local (sem default).
# POSTGRES_PASSWORD=

# Diretório privado APROVADO para snapshots de migração (M15.6A): manifestos,
# CSVs de snapshot e evidências de backup. Sempre fora do Git; nomes de
# arquivo simples (sem caminho) — path traversal é rejeitado fail-closed.
# M15_IMPORT_PRIVATE_DIR=data-private/import-snapshots

# Testes com PostgreSQL real (pytest pula os testes PG sem esta variável):
# M15_TEST_POSTGRES_URL=postgresql+psycopg://postgres:senha@127.0.0.1:55432/m15_teste
