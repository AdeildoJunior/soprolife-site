# SoproLife — EnvironmentFile de exemplo do frescor operacional (M14.3A.1)
# Destino real (criado pelo humano): /etc/soprolife/operational-refresh.env
#
# NUNCA colocar aqui: token, credencial, ID de planilha, URL privada, senha.
# Este arquivo só controla o MODO de execução do timer.

# Modo do timer:
#   check              (padrão seguro — 100% offline, só valida frescor)
#   status             (offline, só relatório)
#   refresh-marketing  (COM REDE — só habilitar depois de autorizar
#                       conscientemente a sincronização automática de
#                       Marketing/SEO; exige ADC já renovado pelo humano)
#
# Nenhum modo publica Apps Script — isso é sempre humano.
SOPROLIFE_REFRESH_MODE=check
