# SoproLife — Atualização automática dos dados do painel.
#
# ESTE ARQUIVO REFLETE A UNIT REAL DE PRODUÇÃO. Ele não pode divergir do que
# está instalado na VPS: o Git não pode mentir sobre o que roda.
#
# ── M23 — MODO POSTGRESQL-ONLY ────────────────────────────────────────────
# A esteira deixou de executar qualquer leitor de Google Sheets. Os snapshots
# do painel passam a ser gerados pela CLI do Núcleo M15 diretamente do
# PostgreSQL (`app.cli exportar-snapshots`), e por isso a unit agora carrega
# o EnvironmentFile do núcleo — é dele que vem M15_DATABASE_URL.
#
# CLOUDSDK_CONFIG foi REMOVIDO: era a variável que mantinha vivo o ADC pessoal
# dos conectores de Sheets (CRM Clínicas, CRM Espirometria,
# Financeiro_Lancamentos, Pastore, Log Auditoria). Esse ADC venceu e gerava
# erro a cada disparo do timer; com o M23 ele deixou de ser dependência e não
# deve ser renovado. Sem esta variável, nenhum conector legado encontra
# credencial — e o guarda de scripts/data_source_mode.py já os bloqueia antes
# disso, fail-closed.
#
# SOPROLIFE_ALLOW_LEGACY_SHEETS_MIGRATION NÃO é definida aqui, nem em nenhuma
# outra unit. É o escape humano para migração/forense pontual; se o timer
# conseguisse executar um leitor de planilha, o guarda teria falhado.
#
# Search Console e GA4 CONTINUAM funcionando: leitura por conta de serviço
# dedicada em /opt/soprolife/secrets/marketing-readonly.json, apontada por
# SOPROLIFE_MARKETING_CREDENTIALS. SOPROLIFE_MARKETING_REQUIRE_SERVICE_ACCOUNT=1
# impede retorno silencioso ao ADC pessoal: sem a conta de serviço o conector
# falha fechado com estado "credencial pendente".
#
# SOPROLIFE_MARKETING_PYTHON aponta o venv DEDICADO de Marketing. Sem ela, o
# conector herdava o "python3" do PATH acima — que é o venv da API M15 — e
# quebrava com "No module named 'googleapiclient'" (2º incidente do M23),
# porque as bibliotecas do Google não estão nem devem estar no venv que serve
# a API. Os dois ambientes são separados de propósito: uma falha de
# instalação do Marketing não pode chegar perto da fonte operacional.
#
# Nenhum segredo aparece em ExecStart, Environment ou journal: apenas o
# CAMINHO da credencial, nunca o conteúdo.

[Unit]
Description=SoproLife — Atualização automática dos dados do painel
Documentation=https://github.com/soprolife/soprolife-site
After=network-online.target postgresql.service
Wants=network-online.target
# A fonte canônica precisa estar de pé; sem banco não há o que atualizar.
After=soprolife-m15-api.service

[Service]
Type=oneshot
User=soprolife
Group=soprolife
WorkingDirectory=/opt/soprolife/soprolife-site
Environment=HOME=/home/soprolife
Environment=PATH=/opt/soprolife/venvs/m15/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Credenciais do banco canônico (M15_DATABASE_URL). O conteúdo nunca aparece
# no journal — só o caminho do arquivo.
EnvironmentFile=/opt/soprolife/secrets/m15.env
Environment=SOPROLIFE_M15_PYTHON=/opt/soprolife/venvs/m15/bin/python
Environment=SOPROLIFE_MARKETING_PYTHON=/opt/soprolife/venvs/marketing/bin/python
Environment=SOPROLIFE_MARKETING_CREDENTIALS=/opt/soprolife/secrets/marketing-readonly.json
Environment=SOPROLIFE_MARKETING_REQUIRE_SERVICE_ACCOUNT=1
Environment=SOPROLIFE_MARKETING_REFRESH_QUEUE=/opt/soprolife/soprolife-site/painel-soprolife/nucleo-m15/var/marketing-refresh-request.json
Environment=SOPROLIFE_UPDATE_LOCK=/run/soprolife-update/update-local-data.lock
RuntimeDirectory=soprolife-update
RuntimeDirectoryPreserve=yes
ExecStart=/bin/bash /opt/soprolife/soprolife-site/painel-soprolife/scripts/update-local-data.sh
StandardOutput=journal
StandardError=journal
# Uma execução nunca pode ficar pendurada até o próximo disparo do timer.
TimeoutStartSec=480
# Journal limitado: falha repetida não inunda o log.
LogRateLimitIntervalSec=60
LogRateLimitBurst=300

NoNewPrivileges=true
PrivateTmp=true
# ProtectSystem=full deixa /usr, /boot e /etc somente-leitura; /opt e /home
# continuam graváveis. NÃO usar "strict" aqui: o script escreve em vários
# caminhos e um ReadWritePaths incompleto derrubaria o timer silenciosamente.
ProtectSystem=full
ReadWritePaths=/opt/soprolife/soprolife-site/painel-soprolife/data
ReadWritePaths=/opt/soprolife/soprolife-site/painel-soprolife/data-private
ReadWritePaths=/opt/soprolife/soprolife-site/painel-soprolife/nucleo-m15/var
ReadWritePaths=/home/soprolife/.config
ReadWritePaths=/home/soprolife/.local

[Install]
WantedBy=multi-user.target
